# FusionBanking frontend environment configuration
#
# Copy this file to `.env` (or `.env.local`) and adjust as needed.
# All variables are optional — sensible development defaults are used when omitted.

# Base URL of the Laravel API.
# - Local development with `npm run dev` (Vite proxies /api -> http://localhost:8000):
#     leave empty (defaults to /api)
# - Production or when the API is on a different origin:
#     VITE_API_URL=https://api.your-domain.com/api
VITE_API_URL=/api
